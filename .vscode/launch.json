{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "extensionHost",
			"request": "launch",
			"name": "Extension",
			"preLaunchTask": "npm: webpack-watch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"${workspaceFolder}/samples/GettingStarted"
			],
			"outFiles": [ "${workspaceFolder}/out/**/*" ],
			"debugWebviews": true
		},
		{
 			"type": "extensionHost",
 			"request": "launch",
			"runtimeExecutable": "${execPath}",
 			"name": "iar-debug & iar-build & iar-login",
			"sourceMaps": true,
			"debugWebviews": true,
			"env": {
				"log-to-console": "true"
			},
 			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--extensionDevelopmentPath=${workspaceFolder}/../iar-vsc-build",
				"--extensionDevelopmentPath=${workspaceFolder}/../iar-vsc-login"
 			],
			"outFiles": [
				"${workspaceFolder}/out/**/*.js",
				"${workspaceFolder}/../iar-vsc-build/out/src/extension/main.js",
				"${workspaceFolder}/../iar-vsc-login/out/**/*.js"
			],
		},
		{
			"name": "Run Debugger Tests",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--extensionTestsPath=${workspaceFolder}/out/tests/suites/dbg/index"
			],
			"env": {
				"CSPYSERVER_CRASH_DUMP_DIR": "${workspaceFolder}/cspyserver-crashdumps"
			},
			"outFiles": [ "${workspaceFolder}/out/**/*.js" ],
			"preLaunchTask": "npm: test-compile",
            "presentation": {
                "group": "Tests",
            }
		},
		{
			"name": "Run Configuration Tests",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--extensionTestsPath=${workspaceFolder}/out/tests/suites/config/index",
				"${workspaceFolder}/tests/TestProjects/ConfigTests"
			],
			"outFiles": [ "${workspaceFolder}/out/**/*.js" ],
			"preLaunchTask": "npm: test-compile",
            "presentation": {
                "group": "Tests",
            }
		},
		{
			"name": "Run Webview Tests",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--extensionTestsPath=${workspaceFolder}/out/tests/suites/listwindow/index",
			],
			"outFiles": [ "${workspaceFolder}/out/**/*.js" ],
			"preLaunchTask": "npm: test-compile",
            "presentation": {
                "group": "Tests",
            },
            "env": {
                "log-to-console": "true",
            },
		},
		{
			"name": "Run Webview Component Tests",
			"type": "node",
			"request": "launch",
			"program": "${workspaceFolder}/node_modules/mocha/bin/mocha",
			"args": [
				"--ui",
				"tdd",
				"${workspaceFolder}/out/webviews/**/*.test.js",
			],
			"outFiles": [ "${workspaceFolder}/out/**/*.js" ],
			"preLaunchTask": "npm: test-compile",
            "presentation": {
                "group": "Tests",
            },
		},
	],
}
